# Public backend origin. Do not append /api; the frontend adds API paths itself.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Optional legacy alias for NEXT_PUBLIC_API_URL.
# NEXT_PUBLIC_BACKEND_URL=http://localhost:5000

# Socket.IO backend origin used for real-time notifications.
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# Optional legacy WebSocket variable retained for deployment compatibility.
# The current application uses NEXT_PUBLIC_SOCKET_URL.
# NEXT_PUBLIC_WS_URL=ws://localhost:5000
